{
  "schema_version": 1,
  "catalog_version": "exam-identity-v2",
  "provider_id": "moex",
  "owner": "catalog maintainers",
  "precedence": [
    "explicit category marker",
    "explicit professional category marker",
    "source event marker",
    "provider policy for an official no-level series",
    "review-isolated event bundle"
  ],
  "rules": [
    {"id": "moex.civil.high.1", "match": ["一等考試", "高考一級"], "level_id": "grade-1", "confidence": "high"},
    {"id": "moex.civil.high.2", "match": ["二等考試", "高考二級"], "level_id": "grade-2", "confidence": "high"},
    {"id": "moex.civil.high.3", "match": ["三等考試", "高考三級"], "level_id": "grade-3", "confidence": "high"},
    {"id": "moex.civil.special.4", "match": ["四等考試", "四等"], "level_id": "grade-4", "confidence": "high"},
    {"id": "moex.civil.special.5", "match": ["五等考試", "五等"], "level_id": "grade-5", "confidence": "high"},
    {"id": "moex.civil.ordinary", "match": ["普通考試", "普考"], "level_id": "ordinary", "confidence": "high"},
    {"id": "moex.civil.elementary", "match": ["初等考試", "初考"], "level_id": "elementary", "confidence": "high"},
    {"id": "moex.promotion.rank", "match": ["薦任", "委任", "簡任", "高員級", "員級", "佐級"], "level_id": "provider-specific rank id", "confidence": "high"},
    {"id": "moex.promotion.transition", "match": ["士晉佐", "佐晉員", "員晉高員"], "level_id": "provider-specific transition id", "confidence": "high"},
    {"id": "moex.qualification", "match": ["高等檢定", "普通檢定", "中醫師檢定"], "level_id": "qualification level id", "confidence": "high"},
    {"id": "moex.professional.high", "match": ["專門職業及技術人員高等考試", "高考_專業類科"], "level_id": "professional-high", "confidence": "high"},
    {"id": "moex.professional.screening", "match": ["檢覈筆試", "專技檢覈"], "level_id": "professional-screening", "confidence": "medium"},
    {"id": "moex.event.combined", "match": ["高等暨普通", "高等、普通"], "level_id": "combined", "confidence": "medium", "disposition": "keep separate event bundle; do not invent a level"}
  ],
  "review_policy": {
    "when": ["multiple level markers conflict", "promotion event has no rank/category marker", "source category lacks an authoritative level"],
    "action": "assign an event-specific review bundle and emit ReviewItem with source evidence",
    "prohibited": "merge into a generic canonical-name bundle"
  }
}
